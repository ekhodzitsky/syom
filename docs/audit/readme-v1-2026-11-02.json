  "example": {
    "source_from_readme": "fn main() -> syom::Result<()> {\n    let pcm: Vec<f32> = (0..48_000)\n        .map(|i| 0.3 * (i as f32 * 0.06).sin())\n        .collect();\n    let adts = syom::encode(&[&pcm], 48_000)?;\n    let audio = syom::decode_with(&adts, &syom::DecodeOptions::audio())?;\n    assert_eq!((audio.channels.len(), audio.sample_rate), (1, 48_000));\n    println!(\"{} channel at {} Hz\", audio.channels.len(), audio.sample_rate);\n    Ok(())\n}\n",
    "steps": [
      {
        "command": [
          "cargo",
          "new",
          "syom-demo",
          "--bin"
        ],
        "exit": 0,
        "stdout": "",
        "stderr": "    Creating binary (application) `syom-demo` package\nnote: see more `Cargo.toml` keys and their definitions at https://doc.rust-lang.org/cargo/reference/manifest.html\n"
      },
