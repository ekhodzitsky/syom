+                for i in 0..count + usize::from(tail) {
+                    let actual = worker.recv().unwrap().unwrap();
+                    assert_eq!(actual.frames, if i < count { BATCH_FRAMES } else { 137 });
+                    assert_eq!(
+                        actual
