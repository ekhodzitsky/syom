+            for i in 0..count {
+                if sender.send(block(i, BATCH_FRAMES)).is_err() {
+                    return;
+                }
+            }
+            let result = if fail {
+                Err(AacError::decode("original decoder failure"))
+            } else {
+                Ok(())
