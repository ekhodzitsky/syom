+            Ok(()) => {
+                if let Some(block) = tail
+                    && self.send(block).is_err()
+                {
+                    return;
+                }
+                let _ = self.flush();
+            }
+            Err(error) => {
+                // Completed logical blocks precede errors; incomplete PCM is discarded.
+                if self.flush().is_ok() {
+                    let _ = self.tx.send(Err(map_aac(error)));
+                }
+            }
+        }
+    }
+}
