+            -0.0,
+            1.0,
+            -1.0,
+            f32::MIN_POSITIVE,
+            f32::from_bits(1),
+            f32::MAX,
+            f32::INFINITY,
+            f32::NEG_INFINITY,
+            f32::NAN,
+        ];
+        let right = [
+            -0.0,
+            -0.0,
+            -0.5,
+            0.5,
+            -f32::MIN_POSITIVE,
+            f32::from_bits(1),
+            -f32::MAX,
+            f32::NEG_INFINITY,
+            f32::INFINITY,
+            1.0,
+        ];
+        for planes in [
+            vec![],
+            vec![&left[..]],
+            vec![&left[..], &right[..]],
+            vec![&left[..], &right[..], &left[..]],
+            vec![&left[..], &right[..3]],
+        ] {
+            let mut actual = vec![17.0, -0.0];
+            let mut expected = actual.clone();
+            original(&mut expected, &planes);
+            append_mono_planes(&mut actual, &planes);
+            assert_eq!(
+                actual.iter().map(|v| v.to_bits()).collect::<Vec<_>>(),
+                expected.iter().map(|v| v.to_bits()).collect::<Vec<_>>()
+            );
+        }
+    }
+}
